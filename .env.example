# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO
OFFLINE_MODE=false

# ---- Postgres (app connects as nawa_app; migrations use the owner) ----
POSTGRES_DB=nawa
POSTGRES_OWNER_USER=nawa_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_USER=nawa_app
POSTGRES_APP_PASSWORD=change-me
# The API runs as the non-owner role nawa_app (created by the first migration) so Row-Level
# Security cannot be bypassed. The password here must equal POSTGRES_APP_PASSWORD.
DATABASE_URL=postgresql+asyncpg://nawa_app:change-me@postgres:5432/nawa
# Migrations only. Uses POSTGRES_OWNER_USER / POSTGRES_OWNER_PASSWORD.
DATABASE_OWNER_URL=postgresql+asyncpg://nawa_owner:change-me@postgres:5432/nawa

# ---- Auth ----
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# ---- Optional tuning (commented out: the defaults below are what the code uses) ----
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# INVITE_TTL_SECONDS=604800
# LOGIN_LIMIT_PER_EMAIL=5
# LOGIN_LIMIT_PER_IP=20
# LOGIN_WINDOW_SECONDS=300
# OLLAMA_API_BASE=http://ollama:11434
# DEMO_DATABASE_NAME=noesantara

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Knowledge uploads (shared by api and worker via the `uploads` volume) ----
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200

# ---- Retrieval and chat (defaults shown; see docs/adr/0009) ----
RAG_VECTOR_K=30
RAG_KEYWORD_K=30
RAG_RRF_K=60
RAG_FINAL_K=20
RAG_RERANK_TOP_N=20
RAG_CONTEXT_K=5
# Calibrated on the golden set (docs/evaluation-report.md); re-calibrate after changing chunker or embedding model.
RAG_MIN_SIMILARITY=0.60
RAG_CONTEXT_MAX_TOKENS=3000
CHAT_LIMIT_PER_MINUTE=20

# ---- Reranker (optional; compose profile `reranker`) ----
RERANKER_ENABLED=false
RERANKER_URL=http://reranker:80
# On CPU the cross-encoder takes ~2 s per passage (about 40 s for 20); raise this for evaluation.
RERANKER_TIMEOUT_SECONDS=10

# ---- LLM gateway (used from slice C) ----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=ollama/qwen2.5:7b
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=ollama/bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b
DEEPSEEK_API_KEY=
DAILY_COST_LIMIT_USD=2

# ---- Langfuse v3 (profile: observability) ----
# Compose interpolates the whole file, so every LANGFUSE_* variable must be set even for `make dev-lite`.
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
# MUST be exactly 64 hex characters (openssl rand -hex 32), or Langfuse will not start.
# `make dev` starts Langfuse.
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me

# ---- Langfuse tracing (used by `make dev`; leave all of these empty for `make dev-lite`) ----
# On first start Langfuse creates a project with this key pair and a first user, and the API
# sends every LLM call to it. Choose the keys yourself; sign in at http://localhost:3100 with
# the email and password below to see the traces.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me

# ---- Tests (not read by the app) ----
# Owner URL of any existing database, used by integration tests to create a scratch database:
# TEST_DATABASE_OWNER_URL=postgresql+asyncpg://nawa_owner:<owner password>@127.0.0.1:5432/postgres
