# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO
OFFLINE_MODE=false

# ---- Postgres (app connects as nawa_app; migrations use the owner) ----
POSTGRES_DB=nawa
POSTGRES_OWNER_USER=nawa_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_USER=nawa_app
POSTGRES_APP_PASSWORD=change-me
# The API runs as the non-owner role nawa_app (created by the first migration) so Row-Level
# Security cannot be bypassed. The password here must equal POSTGRES_APP_PASSWORD.
DATABASE_URL=postgresql+asyncpg://nawa_app:change-me@postgres:5432/nawa
# Migrations only. Uses POSTGRES_OWNER_USER / POSTGRES_OWNER_PASSWORD.
DATABASE_OWNER_URL=postgresql+asyncpg://nawa_owner:change-me@postgres:5432/nawa

# ---- Auth ----
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- LLM gateway (used from slice C) ----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODEL=ollama/qwen2.5:7b
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=ollama/bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b
DEEPSEEK_API_KEY=
DAILY_COST_LIMIT_USD=2

# ---- Langfuse v3 (profile: observability) ----
# Compose interpolates the whole file, so every LANGFUSE_* variable must be set even for `make dev-lite`.
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
# MUST be exactly 64 hex characters (openssl rand -hex 32), or Langfuse will not start.
# `make dev` starts Langfuse.
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me

# ---- Tests (not read by the app) ----
# Owner URL of any existing database, used by integration tests to create a scratch database:
# TEST_DATABASE_OWNER_URL=postgresql+asyncpg://nawa_owner:<owner password>@127.0.0.1:5432/postgres
